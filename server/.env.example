# Configuracion del servidor de SAC Quest (Docker, ver docs/docker.md).
# Copiar a server/.env y completar APP_SECRET y TUNNEL_TOKEN.
# No hay API keys de servicios externos: el proyecto no usa ninguno.
# NODE_ENV, HOST, PORT, DATA_DIR y STATIC_DIR los fija docker-compose.yml.

# ============================================================
#  DOMINIO  (lo unico que hay que cambiar si cambia el dominio)
# ============================================================
# Donde abren los participantes, sin https://. Con esto se arman los QR y se
# permite el acceso (CORS).
APP_DOMAIN=sacquest.penginexr.com

# ============================================================
#  SECRETO  (generarlo una vez y no compartirlo)
# ============================================================
# Firma las URLs de las fotos privadas. Si cambia, los enlaces viejos dejan de
# funcionar (nada se pierde). Generar con:  openssl rand -base64 32
APP_SECRET=

# ============================================================
#  CLOUDFLARE TUNNEL
# ============================================================
# Token del tunel (Zero Trust → Networks → Tunnels → sac-quest).
TUNNEL_TOKEN=

# ============================================================
#  OPCIONAL
# ============================================================
# Tamaño maximo de una foto (MB). El telefono ya la reduce a ~0.5 MB.
MAX_PHOTO_MB=10
